FROM php:8.4-apache
RUN apt-get update && apt-get install -y --no-install-recommends git unzip libxml2-dev libpng-dev libzip-dev libpq-dev \
    && docker-php-ext-install -j2 bcmath soap gd zip pdo_pgsql \
    && rm -rf /var/lib/apt/lists/*
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer
WORKDIR /var/www/html
# Render monta los archivos secretos con acceso para el grupo 1000.
RUN (getent group 1000 >/dev/null || groupadd --gid 1000 render-secrets) \
    && usermod --append --groups 1000 www-data
RUN chown root:root /var/www/html && git init . \
    && git fetch --depth=1 https://github.com/angelitosystems/fact_api.git 3adec6840e6df4d49b8f3bb5d7598c341abb5ac6 \
    && git checkout --detach FETCH_HEAD
COPY fact-api-beta.patch /tmp/j2f.patch
RUN git apply /tmp/j2f.patch && rm -rf .git && rm -f .env \
    && COMPOSER_ALLOW_SUPERUSER=1 composer install --no-dev --prefer-dist --optimize-autoloader --no-interaction \
    && a2enmod rewrite && sed -i 's|DocumentRoot /var/www/html|DocumentRoot /var/www/html/public|' /etc/apache2/sites-available/000-default.conf \
    && chown -R www-data:www-data storage bootstrap/cache \
    && mkdir -p storage/app/private/certificado \
    && ln -s /etc/secrets/certificado.pem storage/app/private/certificado/certificado.pem
# Administrar el emisor por consola.
RUN printf '%s\n' '<LocationMatch "^/(?!index[.]php$|api/v1/(companies/[0-9]+/?$|invoices(/|$)))">' 'Require all denied' '</LocationMatch>' > /etc/apache2/conf-available/j2f-api.conf \
    && a2enconf j2f-api
ENV APP_ENV=production APP_DEBUG=false LOG_CHANNEL=stderr
